
import SwiftUI

class LibraryResource: ObservableObject, Identifiable {
    let id = UUID()
    let title: String
    let author: String
    let publicationYear: Int

    @Published private(set) var isAvailable = true

    init(title: String, author: String, publicationYear: Int) {
        self.title = title
        self.author = author
        self.publicationYear = publicationYear
    }

    fileprivate func setAvailability(_ value: Bool) {
        isAvailable = value
    }

    func borrow() -> String {
        guard isAvailable else {
            return "This resource is not available."
        }

        setAvailability(false)
        return "Borrowing successful."
    }

    func returnResource() -> String {
        guard !isAvailable else {
            return "This resource has not been borrowed."
        }

        setAvailability(true)
        return "Return successful."
    }

    func calculateFee(lateDays: Int) -> Double {
        return 0
    }
}

class PrintedBook: LibraryResource {
    let isbn: String
    let isShortLoan: Bool

    init(
        title: String,
        author: String,
        publicationYear: Int,
        isbn: String,
        isShortLoan: Bool
    ) {
        self.isbn = isbn
        self.isShortLoan = isShortLoan

        super.init(
            title: title,
            author: author,
            publicationYear: publicationYear
        )
    }

    override func calculateFee(lateDays: Int) -> Double {
        return Double(max(0, lateDays)) * 5000
    }
}

class AcademicJournal: LibraryResource {
    let volume: Int
    let issue: Int
    let canBorrow: Bool

    init(
        title: String,
        author: String,
        publicationYear: Int,
        volume: Int,
        issue: Int,
        canBorrow: Bool
    ) {
        self.volume = volume
        self.issue = issue
        self.canBorrow = canBorrow

        super.init(
            title: title,
            author: author,
            publicationYear: publicationYear
        )
    }

    override func borrow() -> String {
        guard canBorrow else {
            return "This journal is for in-library use only."
        }

        return super.borrow()
    }

    override func calculateFee(lateDays: Int) -> Double {
        return Double(max(0, lateDays)) * 8000
    }
}

class DigitalMaterial: LibraryResource {
    let platform: String
    let licenseExpiration: Date
    let maximumUsers: Int

    @Published private(set) var currentUsers = 0

    init(
        title: String,
        author: String,
        publicationYear: Int,
        platform: String,
        licenseExpiration: Date,
        maximumUsers: Int
    ) {
        self.platform = platform
        self.licenseExpiration = licenseExpiration
        self.maximumUsers = maximumUsers

        super.init(
            title: title,
            author: author,
            publicationYear: publicationYear
        )

        setAvailability(
            maximumUsers > 0 && Date() <= licenseExpiration
        )
    }

    override func borrow() -> String {
        guard Date() <= licenseExpiration else {
            return "The digital license has expired."
        }

        guard currentUsers < maximumUsers else {
            return "Maximum users reached."
        }

        currentUsers += 1

        setAvailability(
            currentUsers < maximumUsers && Date() <= licenseExpiration
        )

        return "Access granted successfully."
    }

    override func returnResource() -> String {
        guard currentUsers > 0 else {
            return "There is no active session."
        }

        currentUsers -= 1

        setAvailability(
            currentUsers < maximumUsers && Date() <= licenseExpiration
        )

        return "Access closed successfully."
    }

    override func calculateFee(lateDays: Int) -> Double {
        return 10000
    }
}


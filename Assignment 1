struct ContentView: View {
    @StateObject private var viewModel = LibraryViewModel()

    var body: some View {
        NavigationStack {
            List {
                ForEach(viewModel.resources) { resource in
                    NavigationLink {
                        ResourceDetailView(resource: resource)
                    } label: {
                        VStack(alignment: .leading, spacing: 6) {
                            Text(resource.title)
                                .font(.headline)

                            Text(resource.author)
                                .font(.subheadline)
                                .foregroundColor(.secondary)

                            HStack {
                                Text(resource is PrintedBook ? "Printed Book" :
                                     resource is AcademicJournal ? "Academic Journal" :
                                     "Digital Material")

                                Spacer()

                                Text(resource.isAvailable ? "Available" : "Unavailable")
                                    .foregroundColor(
                                        resource.isAvailable ? .green : .red
                                    )
                            }
                            .font(.caption)
                        }
                        .padding(.vertical, 4)
                    }
                }
            }
            .navigationTitle("Library Resources")
        }
    }
}

struct ResourceDetailView: View {
    @ObservedObject var resource: LibraryResource

    @State private var message = ""
    @State private var showAlert = false
    @State private var lateDays = 0

    var body: some View {
        Form {
            Section("Resource Information") {
                DetailRow(title: "Title", value: resource.title)
                DetailRow(title: "Author", value: resource.author)
                DetailRow(
                    title: "Publication Year",
                    value: "\(resource.publicationYear)"
                )

                DetailRow(
                    title: "Resource Type",
                    value: resource is PrintedBook ? "Printed Book" :
                           resource is AcademicJournal ? "Academic Journal" :
                           "Digital Material"
                )

                DetailRow(
                    title: "Availability",
                    value: resource.isAvailable ? "Available" : "Unavailable"
                )
            }

            if let book = resource as? PrintedBook {
                Section("Book Information") {
                    DetailRow(title: "ISBN", value: book.isbn)
                    DetailRow(
                        title: "Loan Type",
                        value: book.isShortLoan ? "Short Loan" : "Regular Loan"
                    )
                }
            }

            if let journal = resource as? AcademicJournal {
                Section("Journal Information") {
                    DetailRow(title: "Volume", value: "\(journal.volume)")
                    DetailRow(title: "Issue", value: "\(journal.issue)")
                    DetailRow(
                        title: "Borrowing",
                        value: journal.canBorrow ? "Allowed" : "In-library only"
                    )
                }
            }

            if let digital = resource as? DigitalMaterial {
                Section("Digital Material Information") {
                    DetailRow(title: "Platform", value: digital.platform)
                    DetailRow(
                        title: "Maximum Users",
                        value: "\(digital.maximumUsers)"
                    )
                    DetailRow(
                        title: "Current Users",
                        value: "\(digital.currentUsers)"
                    )
                    DetailRow(
                        title: "License Expiration",
                        value: digital.licenseExpiration.formatted(
                            date: .abbreviated,
                            time: .omitted
                        )
                    )
                }
            }

            Section("Library Operations") {
                Button("Borrow Resource / Request Access") {
                    message = resource.borrow()
                    showAlert = true
                }
                .disabled(
                    !resource.isAvailable ||
                    (resource is DigitalMaterial &&
                     Date() > (resource as! DigitalMaterial).licenseExpiration)
                )

                Button("Return Resource / Close Access") {
                    message = resource.returnResource()
                    showAlert = true
                }
                .disabled(
                    resource is DigitalMaterial
                    ? (resource as! DigitalMaterial).currentUsers == 0
                    : resource.isAvailable
                )
            }

            Section("Late Fee Calculation") {
                Stepper(
                    "Late Days: \(lateDays)",
                    value: $lateDays,
                    in: 0...365
                )

                DetailRow(
                    title: "Total Fee",
                    value: "\(Int(resource.calculateFee(lateDays: lateDays))) VND"
                )
            }

            Section("Validation Test") {
                Button("Test Invalid Borrowing") {
                    message = resource.borrow()
                    showAlert = true
                }
            }
        }
        .navigationTitle("Resource Details")
        .navigationBarTitleDisplayMode(.inline)
        .alert("Library System", isPresented: $showAlert) {
            Button("OK", role: .cancel) {}
        } message: {
            Text(message)
        }
    }
}

struct DetailRow: View {
    let title: String
    let value: String

    var body: some View {
        HStack {
            Text(title)
            Spacer()
            Text(value)
                .foregroundColor(.secondary)
                .multilineTextAlignment(.trailing)
        }
    }
}

